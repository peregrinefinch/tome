    parsed,
    _expected_table(
      [
        #("127.0.0.1", _expected_text("value")),
        #("character encoding", _expected_text("value")),
        #("key2", _expected_text("value")),
        #("quoted \"value\"", _expected_text("value")),
        #("ʎǝʞ", _expected_text("value"))
      ]
    )
  )
}

