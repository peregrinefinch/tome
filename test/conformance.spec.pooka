test "valid/spec-example-1" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/spec-example-1.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #("title", _expected_text("TOML Example")),
        #(
          "clients",
          _expected_table(
            [
              #(
                "data",
                _expected_array(
                  [
                    _expected_array(
                      [_expected_text("gamma"), _expected_text("delta")]
                    ),
                    _expected_array(
                      [_expected_integer(1), _expected_integer(2)]
                    )
                  ]
                )
              ),
              #(
                "hosts",
                _expected_array(
                  [_expected_text("alpha"), _expected_text("omega")]
                )
              )
            ]
          )
        ),
        #(
          "database",
          _expected_table(
            [
              #("connection_max", _expected_integer(5000)),
              #("enabled", _expected_boolean(True)),
              #("server", _expected_text("192.168.1.1")),
              #(
                "ports",
                _expected_array(
                  [
                    _expected_integer(8001),
                    _expected_integer(8001),
                    _expected_integer(8002)
                  ]
                )
              )
            ]
          )
        ),
        #(
          "owner",
          _expected_table(
            [
              #("dob", _expected_datetime("1979-05-27T07:32:00-08:00")),
              #("name", _expected_text("Lance Uppercut"))
            ]
          )
        ),
        #(
          "servers",
          _expected_table(
            [
              #(
                "alpha",
                _expected_table(
                  [
                    #("dc", _expected_text("eqdc10")),
                    #("ip", _expected_text("10.0.0.1"))
                  ]
                )
              ),
              #(
                "beta",
                _expected_table(
                  [
                    #("dc", _expected_text("eqdc10")),
                    #("ip", _expected_text("10.0.0.2"))
                  ]
                )
              )
            ]
          )
        )
      ]
    )
  )
}

