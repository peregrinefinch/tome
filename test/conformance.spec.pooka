    parsed,
    _expected_table(
      [
        #("basic_string", _expected_text("~  ÿ ퟿  ￿ 𐀀 􏿿")),
        #(
          "escaped_string",
          _expected_text("\u{0} \u{8} \u{c} A \u{7f}  ÿ ퟿  ￿ 𐀀 􏿿")
        ),
        #("literal_string", _expected_text("~  ÿ ퟿  ￿ 𐀀 􏿿")),
        #(
          "not_escaped_string",
          _expected_text(
            "\\u0000 \\u0008 \\u000c \\U00000041 \\u007f \\u0080 \\u00ff \\ud7ff \\ue000 \\uffff \\U00010000 \\U0010ffff"
          )
        )
      ]
    )
  )
}

