        ),
        #(
          "arr-2",
          _expected_array(
            [
              _expected_text("str"),
              _expected_table(
                [#("a", _expected_table([#("b", _expected_integer(1))]))]
              )
            ]
          )
        ),
        #(
          "arr-3",
          _expected_array(
            [
              _expected_table(
                [#("a", _expected_table([#("b", _expected_integer(1))]))]
              ),
              _expected_table(
                [#("a", _expected_table([#("b", _expected_integer(2))]))]
              )
            ]
          )
        ),
        #(
          "arr-4",
          _expected_array(
            [
              _expected_text("str"),
              _expected_table(
                [#("a", _expected_table([#("b", _expected_integer(1))]))]
              ),
              _expected_table(
                [#("a", _expected_table([#("b", _expected_integer(2))]))]
              )
            ]
          )
        )
      ]
    )
  )
}

