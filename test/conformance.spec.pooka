  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "a",
          _expected_table(
            [
              #(" x ", _expected_table([])),
              #("b.c", _expected_table([])),
              #("d.e", _expected_table([])),
              #("b", _expected_table([#("c", _expected_table([]))]))
            ]
          )
        ),
        #(
          "d",
          _expected_table(
            [#("e", _expected_table([#("f", _expected_table([]))]))]
          )
        ),
        #(
          "g",
          _expected_table(
            [#("h", _expected_table([#("i", _expected_table([]))]))]
          )
        ),
        #(
          "j",
          _expected_table(
            [#("ʞ", _expected_table([#("l", _expected_table([]))]))]
          )
        ),
        #(
          "x",
          _expected_table(
            [#("1", _expected_table([#("2", _expected_table([]))]))]
          )
        )
      ]
    )
  )
}

test "valid/table/names-with-values" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/table/names-with-values.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "a",
          _expected_table(
            [
              #(" x ", _expected_table([#("key", _expected_integer(4))])),
              #(
                "b",
                _expected_table(
                  [#("c", _expected_table([#("key", _expected_integer(1))]))]
                )
              ),
              #("b.c", _expected_table([#("key", _expected_integer(2))])),
              #("d.e", _expected_table([#("key", _expected_integer(3))]))
            ]
          )
        ),
        #(
          "d",
          _expected_table(
            [
              #(
                "e",
                _expected_table(
                  [#("f", _expected_table([#("key", _expected_integer(5))]))]
                )
              )
            ]
          )
        ),
        #(
          "g",
          _expected_table(
            [
              #(
                "h",
                _expected_table(
                  [#("i", _expected_table([#("key", _expected_integer(6))]))]
                )
              )
            ]
          )
        ),
        #(
          "j",
          _expected_table(
            [
              #(
                "ʞ",
                _expected_table(
                  [#("l", _expected_table([#("key", _expected_integer(7))]))]
                )
              )
            ]
          )
        ),
        #(
          "x",
          _expected_table(
            [
              #(
                "1",
                _expected_table(
                  [#("2", _expected_table([#("key", _expected_integer(8))]))]
                )
              )
            ]
          )
        )
      ]
    )
  )
}

