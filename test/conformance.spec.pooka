        ),
        #(
          "equivalent_two",
          _expected_text("The quick brown fox jumps over the lazy dog.")
        ),
        #("escape-bs-1", _expected_text("a \\\nb")),
        #("escape-bs-2", _expected_text("a \\b")),
        #("escape-bs-3", _expected_text("a \\\\\n  b")),
        #("keep-ws-before", _expected_text("a   \tb")),
        #("no-space", _expected_text("ab")),
        #(
          "whitespace-after-bs",
          _expected_text("The quick brown fox jumps over the lazy dog.")
        )
      ]
    )
  )
}

