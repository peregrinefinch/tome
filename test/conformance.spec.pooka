test "valid/inline-table/nest" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/inline-table/nest.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "arr_arr_tbl_empty",
          _expected_array([_expected_array([_expected_table([])])])
        ),
        #(
          "arr_arr_tbl_val",
          _expected_array(
            [
              _expected_array(
                [_expected_table([#("one", _expected_integer(1))])]
              )
            ]
          )
        ),
        #(
          "arr_arr_tbls",
          _expected_array(
            [
              _expected_array(
                [
                  _expected_table([#("one", _expected_integer(1))]),
                  _expected_table([#("two", _expected_integer(2))])
                ]
              )
            ]
          )
        ),
        #(
          "arr_tbl_tbl",
          _expected_array(
            [
              _expected_table(
                [#("tbl", _expected_table([#("one", _expected_integer(1))]))]
              )
            ]
          )
        ),
        #(
          "tbl_arr_tbl",
          _expected_table(
            [
              #(
                "arr_tbl",
                _expected_array(
                  [_expected_table([#("one", _expected_integer(1))])]
                )
              )
            ]
          )
        ),
        #("tbl_tbl_empty", _expected_table([#("tbl_0", _expected_table([]))])),
        #(
          "tbl_tbl_val",
          _expected_table(
            [#("tbl_1", _expected_table([#("one", _expected_integer(1))]))]
          )
        )
      ]
    )
  )
}

