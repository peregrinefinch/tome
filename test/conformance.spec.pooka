test "valid/array/array" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/array/array.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "comments",
          _expected_array([_expected_integer(1), _expected_integer(2)])
        ),
        #(
          "dates",
          _expected_array(
            [
              _expected_datetime("1987-07-05T17:45:00Z"),
              _expected_datetime("1979-05-27T07:32:00"),
              _expected_date("2006-06-01"),
              _expected_time("11:00:00")
            ]
          )
        ),
        #(
          "floats",
          _expected_array(
            [
              _expected_floating(1.1),
              _expected_floating(2.1),
              _expected_floating(3.1)
            ]
          )
        ),
        #(
          "ints",
          _expected_array(
            [_expected_integer(1), _expected_integer(2), _expected_integer(3)]
          )
        ),
        #(
          "strings",
          _expected_array(
            [_expected_text("a"), _expected_text("b"), _expected_text("c")]
          )
        )
      ]
    )
  )
}

