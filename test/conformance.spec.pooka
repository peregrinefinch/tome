  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "x",
          _expected_table(
            [
              #("c", _expected_integer(3)),
              #("d", _expected_integer(4)),
              #(
                "y",
                _expected_table(
                  [
                    #(
                      "z",
                      _expected_table(
                        [
                          #(
                            "w",
                            _expected_table(
                              [
                                #("a", _expected_integer(1)),
                                #("b", _expected_integer(2))
                              ]
                            )
                          )
                        ]
                      )
                    )
                  ]
                )
              )
            ]
          )
        )
      ]
    )
  )
}

_expected_text(value: String) -> Toml {
  TString(value)
}

_expected_integer(value: Int) -> Toml {
  TInt(value)
}

_expected_floating(value: Float) -> Toml {
  TFloat(value)
}

_expected_infinity(value: Bool) -> Toml {
  TInfinity(value)
}

_expected_nan() -> Toml {
  TNan()
}

_expected_boolean(value: Bool) -> Toml {
  TBool(value)
}

_expected_datetime(value: String) -> Toml {
  TDateTime(value)
}

_expected_date(value: String) -> Toml {
  TDate(value)
}

_expected_time(value: String) -> Toml {
  TTime(value)
}

_expected_array(values: List(Toml)) -> Toml {
  TArray(values)
}

_expected_table(values: List(#(String, Toml))) -> Toml {
  TTable(values)
}

_expected_same(actual: Toml, wanted: Toml) -> Bool {
  match #(actual, wanted) {
    #(TString(a), TString(b)) -> a == b
    #(TInt(a), TInt(b)) -> a == b
    #(TFloat(a), TFloat(b)) -> a == b && match a == 0.0 {
      True -> float.to_string(a) == float.to_string(b)
      False -> True
    }
    #(TInfinity(a), TInfinity(b)) -> a == b
    #(TNan(), TNan()) -> True
    #(TBool(a), TBool(b)) -> a == b
    #(TDateTime(a), TDateTime(b)) -> _temporal(a) == _temporal(b)
    #(TDate(a), TDate(b)) -> a == b
    #(TTime(a), TTime(b)) -> _temporal(a) == _temporal(b)
    #(TArray(a), TArray(b)) -> list.length(a) == list.length(b) && list.all(
      list.zip(a, b),
      fn(pair) {
        let #(left, right) = pair
        _expected_same(left, right)
      }
    )
    #(TTable(a), TTable(b)) -> list.length(a) == list.length(b) && list.all(
      b,
      fn(entry) {
        let #(key, value) = entry
        match tome.get(actual, key) {
          Some(found) -> _expected_same(found, value)
          None -> False
        }
      }
    )
    _ -> False
  }
}

// TOML keeps the spelling of a date. The corpus normalises T/Z and pads
// fractions, so compare the same instant spelling with trailing zeroes removed.
_temporal(value: String) -> String {
  let value = string.uppercase(string.replace(value, " ", "T"))
  match string.split_once(value, ".") {
    None -> value
    Some(#(whole, rest)) -> {
      let count = _digits(string.to_list(rest), 0)
      let fraction = _trim_zeroes(string.slice(rest, 0, count))
      let suffix = string.drop_start(rest, count)
      match fraction {
        "" -> whole + suffix
        _ -> whole + "." + fraction + suffix
      }
    }
  }
}

_digits(values: List(Int), count: Int) -> Int {
  match values {
    [c, ..rest] if c >= 48 && c <= 57 -> _digits(rest, count + 1)
    _ -> count
  }
}

_trim_zeroes(value: String) -> String {
  match string.ends_with(value, "0") {
    True -> _trim_zeroes(string.drop_end(value, 1))
    False -> value
  }
}
