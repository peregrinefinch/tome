test "valid/comment/tricky" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/comment/tricky.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "hash#tag",
          _expected_table(
            [
              #("#!", _expected_text("hash bang")),
              #(
                "arr5",
                _expected_array(
                  [
                    _expected_array(
                      [
                        _expected_array(
                          [
                            _expected_array(
                              [_expected_array([_expected_text("#")])]
                            )
                          ]
                        )
                      ]
                    )
                  ]
                )
              ),
              #(
                "arr3",
                _expected_array(
                  [
                    _expected_text("#"),
                    _expected_text("#"),
                    _expected_text("###")
                  ]
                )
              ),
              #(
                "arr4",
                _expected_array(
                  [
                    _expected_integer(1),
                    _expected_integer(2),
                    _expected_integer(3),
                    _expected_integer(4)
                  ]
                )
              ),
              #("tbl1", _expected_table([#("#", _expected_text("}#"))]))
            ]
          )
        ),
        #(
          "section",
          _expected_table(
            [
              #("8", _expected_text("eight")),
              #("eleven", _expected_floating(11.1)),
              #("five", _expected_floating(5.5)),
              #(
                "four",
                _expected_text("# no comment\n# nor this\n#also not comment")
              ),
              #("one", _expected_text("11")),
              #("six", _expected_integer(6)),
              #("ten", _expected_floating(1000.0)),
              #("three", _expected_text("#")),
              #("two", _expected_text("22#"))
            ]
          )
        )
      ]
    )
  )
}

