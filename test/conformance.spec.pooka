test "valid/multibyte" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/multibyte.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "𝐭𝐛𝐥",
          _expected_table(
            [
              #("string", _expected_text("𝓼𝓽𝓻𝓲𝓷𝓰 - #")),
              #(
                "sub",
                _expected_table(
                  [
                    #(
                      "another_test_string",
                      _expected_text("§á₥è ƭλïñϱ, βúƭ ωïƭλ á ƨƭřïñϱ #")
                    ),
                    #(
                      "escapes",
                      _expected_text(
                        " Âñδ ωλèñ \"'ƨ ářè ïñ ƭλè ƨƭřïñϱ, áℓôñϱ ωïƭλ # \""
                      )
                    ),
                    #(
                      "βïƭ#",
                      _expected_table(
                        [
                          #(
                            "multi_line_array",
                            _expected_array([_expected_text("]")])
                          ),
                          #(
                            "ωλáƭ?",
                            _expected_text(
                              "Ýôú δôñ'ƭ ƭλïñƙ ƨô₥è úƨèř ωôñ'ƭ δô ƭλáƭ?"
                            )
                          )
                        ]
                      )
                    ),
                    #(
                      "𝕒𝕣𝕣𝕒𝕪",
                      _expected_array(
                        [_expected_text("] "), _expected_text(" # ")]
                      )
                    ),
                    #(
                      "𝕒𝕣𝕣𝕒𝕪𝟚",
                      _expected_array(
                        [
                          _expected_text("Tèƨƭ #11 ]ƥřôƲèδ ƭλáƭ"),
                          _expected_text("Éжƥèřï₥èñƭ #9 ωáƨ á ƨúççèƨƨ")
                        ]
                      )
                    )
                  ]
                )
              )
            ]
          )
        )
      ]
    )
  )
}

