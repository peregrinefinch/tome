  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #("\u{8}", _expected_text("bell")),
        #("\n", _expected_text("newline")),
        #("\"", _expected_text("just a quote")),
        #("backsp\u{8}\u{8}", _expected_table([])),
        #("À", _expected_text("latin capital letter A with grave")),
        #("\"quoted\"", _expected_table([#("quote", _expected_boolean(True))])),
        #("a.b", _expected_table([#("À", _expected_table([]))]))
      ]
    )
  )
}

test "valid/key/like-date" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/key/like-date.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #("15:16:17", _expected_integer(6)),
        #("2001-02-03", _expected_integer(1)),
        #("2001-02-04", _expected_integer(2)),
        #("2001-02-05", _expected_integer(3)),
        #("2001-02-06T15:16:17+01:00", _expected_integer(4)),
        #("2001-02-07T15:16:17", _expected_integer(5)),
        #(
          "2002-01-04",
          _expected_array([_expected_table([#("k", _expected_integer(12))])])
        ),
        #(
          "2001-02-11",
          _expected_table(
            [#("a", _expected_table([#("2001-02-12", _expected_integer(9))]))]
          )
        ),
        #(
          "2002-01-02",
          _expected_table(
            [
              #("k", _expected_integer(10)),
              #("2024-01-03", _expected_table([#("k", _expected_integer(11))]))
            ]
          )
        ),
        #(
          "a",
          _expected_table(
            [
              #("2001-02-08", _expected_integer(7)),
              #(
                "2001-02-09",
                _expected_table([#("2001-02-10", _expected_integer(8))])
              )
            ]
          )
        )
      ]
    )
  )
}

