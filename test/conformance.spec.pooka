test "valid/spec-1.0.0/array-0" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/spec-1.0.0/array-0.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #(
          "colors",
          _expected_array(
            [
              _expected_text("red"),
              _expected_text("yellow"),
              _expected_text("green")
            ]
          )
        ),
        #(
          "contributors",
          _expected_array(
            [
              _expected_text("Foo Bar <foo@example.com>"),
              _expected_table(
                [
                  #("email", _expected_text("bazqux@example.com")),
                  #("name", _expected_text("Baz Qux")),
                  #("url", _expected_text("https://example.com/bazqux"))
                ]
              )
            ]
          )
        ),
        #(
          "integers",
          _expected_array(
            [_expected_integer(1), _expected_integer(2), _expected_integer(3)]
          )
        ),
        #(
          "nested_arrays_of_ints",
          _expected_array(
            [
              _expected_array([_expected_integer(1), _expected_integer(2)]),
              _expected_array(
                [
                  _expected_integer(3),
                  _expected_integer(4),
                  _expected_integer(5)
                ]
              )
            ]
          )
        ),
        #(
          "nested_mixed_array",
          _expected_array(
            [
              _expected_array([_expected_integer(1), _expected_integer(2)]),
              _expected_array(
                [_expected_text("a"), _expected_text("b"), _expected_text("c")]
              )
            ]
          )
        ),
        #(
          "numbers",
          _expected_array(
            [
              _expected_floating(0.1),
              _expected_floating(0.2),
              _expected_floating(0.5),
              _expected_integer(1),
              _expected_integer(2),
              _expected_integer(5)
            ]
          )
        ),
        #(
          "string_array",
          _expected_array(
            [
              _expected_text("all"),
              _expected_text("strings"),
              _expected_text("are the same"),
              _expected_text("type")
            ]
          )
        )
      ]
    )
  )
}

