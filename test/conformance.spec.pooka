        #("four-quotes", _expected_text("Closing with four quotes\n\"")),
        #("lit_one", _expected_text("'one quote'")),
        #("lit_one_space", _expected_text(" 'one quote' ")),
        #("lit_two", _expected_text("''two quotes''")),
        #("lit_two_space", _expected_text(" ''two quotes'' ")),
        #("mismatch1", _expected_text("aaa'''bbb")),
        #("mismatch2", _expected_text("aaa\"\"\"bbb")),
        #("one", _expected_text("\"one quote\"")),
        #("one_space", _expected_text(" \"one quote\" ")),
        #("two", _expected_text("\"\"two quotes\"\"")),
        #("two_space", _expected_text(" \"\"two quotes\"\" "))
      ]
    )
  )
}

