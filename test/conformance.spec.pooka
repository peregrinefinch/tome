test "valid/key/start" {
  let assert Ok(bytes) = file.read_bytes(
    "test/fixtures/toml/valid/key/start.toml"
  )
  let assert Ok(parsed) = tome.parse_bytes(bytes)
  assert _expected_same(
    parsed,
    _expected_table(
      [
        #("-", _expected_table([#("-", _expected_integer(4))])),
        #("---", _expected_table([#("---", _expected_integer(7))])),
        #("-key", _expected_table([#("-key", _expected_integer(1))])),
        #("1", _expected_table([#("1", _expected_integer(6))])),
        #("111", _expected_table([#("111", _expected_integer(9))])),
        #("1key", _expected_table([#("1key", _expected_integer(3))])),
        #("_", _expected_table([#("_", _expected_integer(5))])),
        #("___", _expected_table([#("___", _expected_integer(8))])),
        #("_key", _expected_table([#("_key", _expected_integer(2))])),
        #(
          "inline",
          _expected_table(
            [
              #(
                "---",
                _expected_table(
                  [
                    #("---", _expected_integer(10)),
                    #("111", _expected_integer(12)),
                    #("___", _expected_integer(11))
                  ]
                )
              )
            ]
          )
        )
      ]
    )
  )
}

